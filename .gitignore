# ============================================================
# .gitignore - Sistema de Semilleros de Investigación UdeA
# ============================================================

# ─── Entornos y secretos ────────────────────────────────────
.env
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# ─── Maven ──────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/
mvnw
mvnw.cmd
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ─── IDE - IntelliJ IDEA ────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# ─── IDE - Eclipse ──────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# ─── IDE - VS Code ──────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── Sistema operativo ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
log/
*.log.*

# ─── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ─── SonarCloud / JaCoCo ────────────────────────────────────
.sonar/
.scannerwork/

# ─── Spring Boot ────────────────────────────────────────────
spring-shell.log
HELP.md

# ─── Node (si se usa frontend) ──────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Cobertura ──────────────────────────────────────────────
*.exec
jacoco.exec
