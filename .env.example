# ============================================================
# .env.example - Plantilla de variables de entorno
# Copie este archivo como .env y configure los valores reales.
# NUNCA incluya valores reales en este archivo de plantilla.
# ============================================================

SPRING_PROFILES_ACTIVE=dev

# ─── Base de datos (PostgreSQL) ─────────────────────────────
DB_NAME=semilleros_dev
DB_USERNAME=semilleros_user
DB_PASSWORD=CHANGE_ME
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/semilleros_dev

# ─── JWT ────────────────────────────────────────────────────
# Genere una clave segura: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=86400000

# ─── Correo SMTP ────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=correo@udea.edu.co
MAIL_PASSWORD=CHANGE_ME

# ─── Aplicación ─────────────────────────────────────────────
APP_PORT=8080
APP_ADMIN_CORREO=admin@udea.edu.co
